{
	"name": "@kitschpatrol/dict-en-wiktionary",
	"version": "1.6.0",
	"description": "An extremely permissive English dictionary sourced from Wiktionary for use with CSpell.",
	"keywords": [
		"cspell",
		"cspell-ext",
		"cspell-dicts",
		"dictionary",
		"wiktionary",
		"english",
		"spellcheck",
		"spelling",
		"npm-package"
	],
	"homepage": "https://github.com/kitschpatrol/dict-en-wiktionary",
	"bugs": "https://github.com/kitschpatrol/dict-en-wiktionary/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/dict-en-wiktionary.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./cspell-ext.json",
		"./cspell": "./cspell-ext.json",
		"./cspell-ext.json": "./cspell-ext.json"
	},
	"files": [
		"cspell-ext.json",
		"dict/en-wiktionary.trie"
	],
	"scripts": {
		"build": "cspell-tools-cli build",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"fix": "ksc fix",
		"lint": "ksc lint",
		"prepare": "skills experimental_sync -y -f",
		"release": "bumpp --commit 'Release: %s' && pnpm build && pnpm publish --otp $(op item get npm --otp)",
		"test": "head -n 1000 \"src/en-wiktionary.txt\" | cspell -c ./cspell-ext.json \"--locale=en,en-US\" \"--languageId=*\" stdin",
		"update": "tsx ./scripts/generate-dictionary.ts"
	},
	"devDependencies": {
		"@cspell/cspell-tools": "^10.3.6",
		"@kitschpatrol/shared-config": "^8.13.1",
		"@types/node": "~24.13.6",
		"bumpp": "^12.3.0",
		"pretty-bytes": "^7.2.0",
		"shx": "^0.4.0",
		"skills": "^1.7.0",
		"tsx": "^4.23.15",
		"typescript": "~6.0.3"
	},
	"packageManager": "pnpm@12.9.1",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24.16.0 || >=26.3.0"
		}
	},
	"publishConfig": {
		"access": "public"
	}
}
