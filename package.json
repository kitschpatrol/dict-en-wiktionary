{
	"name": "@kitschpatrol/dict-en-wiktionary",
	"version": "1.1.1",
	"description": "An extremely permissive English dictionary sourced from Wiktionary for use with CSpell.",
	"keywords": [
		"cspell",
		"cspell-ext",
		"cspell-dicts",
		"dictionary",
		"wiktionary",
		"english",
		"spellcheck",
		"spelling",
		"npm-package"
	],
	"homepage": "https://github.com/kitschpatrol/dict-en-wiktionary",
	"bugs": "https://github.com/kitschpatrol/dict-en-wiktionary/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/dict-en-wiktionary.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"type": "module",
	"exports": {
		".": "./cspell-ext.json",
		"./cspell": "./cspell-ext.json",
		"./cspell-ext.json": "./cspell-ext.json"
	},
	"files": [
		"cspell-ext.json",
		"dict/en-wiktionary.trie"
	],
	"scripts": {
		"build": "cspell-tools-cli build",
		"clean": "git rm -f pnpm-lock.yaml ; git clean -fdX",
		"fix": "kpi fix",
		"lint": "kpi lint",
		"release": "bumpp --commit 'Release: %s' && pnpm run build && NPM_AUTH_TOKEN=$(op read 'op://Personal/npm/token') && pnpm publish",
		"test": "head -n 1000 \"src/en-wiktionary.txt\" | cspell -c ./cspell-ext.json \"--locale=en,en-US\" \"--languageId=*\" stdin",
		"update": "tsx ./scripts/generate-dictionary.ts"
	},
	"devDependencies": {
		"@cspell/cspell-tools": "^9.2.2",
		"@kitschpatrol/shared-config": "^5.8.1",
		"@types/node": "^20.19.24",
		"bumpp": "^10.3.1",
		"pretty-bytes": "^7.1.0",
		"tsx": "^4.20.6",
		"typescript": "~5.9.3"
	},
	"packageManager": "pnpm@10.20.0",
	"engines": {
		"node": ">=18.0.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
